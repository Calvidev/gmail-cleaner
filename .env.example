# ---------------------------------------------------------------------------
# Fantasy Tool — copia este archivo a `.env` y ajusta lo que necesites.
# Todo tiene un valor por defecto razonable: la herramienta arranca sin tocar
# nada de esto.
#
# Se leen DOS archivos, en este orden:
#   .env.defaults   valores no secretos versionados en el repositorio
#                   (ahí está ya configurada la liga)
#   .env            este archivo; lo que pongas aquí manda sobre lo anterior
#
# Las llaves van siempre en `.env`, que git ignora.
# ---------------------------------------------------------------------------

# --- Servidor ---
HOST=127.0.0.1
PORT=8000
DEBUG=false

# --- Solo si publicas la herramienta en internet ---
# Orígenes que pueden llamar a la API desde un navegador. En local no hace falta
# tocarlo; publicada, pon tu dominio para que ninguna otra web la use.
# CORS_ORIGINS=["https://fantasy.calvi.dev"]

# Clave para poder vaciar la caché (cabecera X-Admin-Token). Sin ella cualquiera
# podría forzar descargas repetidas y hacer que Sleeper limite tu IP.
# Genérala con: openssl rand -hex 24
# ADMIN_TOKEN=

# Modo demo: usa los datos de ejemplo de `data/demo/` en vez de salir a
# internet. Sirve para probar la interfaz sin conexión.
FANTASY_DEMO=false

# --- Sleeper ---------------------------------------------------------------
# La API de LECTURA de Sleeper es pública: el ranking y las noticias funcionan
# sin ninguna llave. Lo de abajo solo hace falta para las funciones de liga
# (ver tu roster y filtrar agentes libres).

# Estos dos ya vienen puestos en `.env.defaults`. Solo hacen falta aquí si
# quieres apuntar a OTRA liga o a otro usuario.

# Tu nombre de usuario en Sleeper (el del login, no el nombre del equipo).
# SLEEPER_USERNAME=tu_usuario

# El id de tu liga. Se ve en la URL de la web de Sleeper:
# https://sleeper.com/leagues/<ESTE_NÚMERO>/team
# SLEEPER_LEAGUE_ID=123456789012345678

# Tu id de usuario numérico. Es la vía más fiable para que la herramienta sepa
# cuál de los equipos es el tuyo, por si el nombre que se ve en la liga no
# coincide con el de tu cuenta. Se puede consultar en:
# https://api.sleeper.app/v1/user/TU_USUARIO
# SLEEPER_USER_ID=987654321098765432

# Hueco para un token, por si algún día usas un endpoint autenticado o un
# proveedor de datos de pago. Hoy no hace falta.
# SLEEPER_API_KEY=

# Temporada a consultar. Si se deja vacío se detecta sola.
# SLEEPER_SEASON=2025
SLEEPER_SEASON_TYPE=regular

# --- Apuestas --------------------------------------------------------------
# El spread y el total de cada partido salen de ESPN y NO necesitan llave:
# la vista de Apuestas funciona tal cual.
#
# Con una llave de https://the-odds-api.com (tiene plan gratuito) se añaden
# además las líneas por jugador: yardas de recepción, recepciones, TD...
# ODDS_API_KEY=

# --- Caché (segundos) ------------------------------------------------------
CACHE_TTL_PLAYERS=43200
CACHE_TTL_TRENDING=900
CACHE_TTL_NEWS=600
CACHE_TTL_STATS=10800
CACHE_TTL_STATE=1800
CACHE_TTL_WEEK_STATS=21600
CACHE_TTL_ODDS=1200

# --- Red -------------------------------------------------------------------
HTTP_TIMEOUT=20
